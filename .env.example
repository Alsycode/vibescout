# =============================================================================
# Haum / VibeScout — Backend environment (.env)
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# All values below are placeholders / safe defaults, not secrets.
# =============================================================================

# --- Core ---------------------------------------------------------------------
PORT=3001
# development | production | test
NODE_ENV=development
# Public origin of the frontend. Used for CORS origin and email links.
FRONTEND_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Local dev: mongodb://localhost:27017/haum
# Tests use a separate database — see .env.test.example (haum_test)
MONGODB_URI=mongodb://localhost:27017/haum

# --- Redis (Upstash REST) ---------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# --- Redis (Upstash TCP — PERF-1, BullMQ job queue) --------------------------
# Same Upstash database as above, different connection method: Upstash console
# → your database → "Redis Connect" (not "REST API") tab → copy the rediss:// URL.
# Used only by the queue producer (src/queues/pipelineQueue.js) and the worker
# process (worker.js) — never by the REST client in src/lib/redis.js.
UPSTASH_REDIS_URL=rediss://default:your-password@your-db.upstash.io:6379

# --- Auth / cookies -------------------------------------------------------
# Must be >= 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
# Optional, defaults to "7d" in code
JWT_EXPIRES_IN=7d
# Cookie domain for the session cookie. Leave blank for localhost.
COOKIE_DOMAIN=

# --- Payments (Razorpay) ------------------------------------------------
# Use rzp_test_* keys for dev/test, rzp_live_* only in production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# From the Razorpay dashboard webhook config (Settings → Webhooks) — required,
# validates POST /payment/webhook's X-Razorpay-Signature header.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- External APIs -------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
# Google: Places + Place Details + Air Quality (server key, IP-restricted)
GOOGLE_PLACES_API_KEY=your-google-places-api-key
OPENAQ_API_KEY=your-openaq-api-key
OPENWEATHER_API_KEY=your-openweather-api-key
WAQI_API_KEY=your-waqi-api-key
GNEWS_API_KEY=your-gnews-api-key
NEWSAPI_API_KEY=your-newsapi-api-key
CPCB_API_KEY=your-cpcb-api-key
# Present in some deployments' .env but not referenced in code — remove if unused
HOWLOUD_API_KEY=

# --- Email (nodemailer SMTP) ------------------------------------------
# Password-reset email. If EMAIL_HOST/USER/PASS are unset, email sending is skipped.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=no-reply@example.com
EMAIL_PASS=your-smtp-password
# Optional, defaults to "Haum <EMAIL_USER>"
EMAIL_FROM=Haum <no-reply@example.com>

# --- Cloudinary (blog / image uploads) ------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --- Dev only ----------------------------------------------------------------
# When "true", mounts /dev routes (free report unlock). MUST be unset in production.
DEV_UNLOCK=false
# No ROLE var needed — PERF-3 (cron single-owner) is implemented by process
# separation instead: cron only starts in worker.js (never server.js), backed
# by a Redis lock (src/lib/cronLock.js) so it's still safe if worker.js is
# itself ever scaled to more than one instance.
