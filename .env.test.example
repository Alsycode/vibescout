# =============================================================================
# Haum / VibeScout — TEST environment (.env.test)
# Copy to `.env.test` for local test runs. CI writes its own from secrets.
# The test runner (vitest, added in task 0.3) loads this file and asserts
# MONGODB_URI points at a throwaway "*_test" database before touching Mongo.
# Every value here is a placeholder — no real secrets.
# =============================================================================

# --- Core ---------------------------------------------------------------------
NODE_ENV=test
PORT=3101
FRONTEND_URL=http://localhost:3000

# --- Database (MUST be a disposable test DB) --------------------------------
# Local:  mongodb://localhost:27017/haum_test
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/haum_test?retryWrites=true&w=majority
# The name has to contain "_test" or the test setup refuses to run.
MONGODB_URI=mongodb://localhost:27017/haum_test

# --- Redis ---------------------------------------------------------------------
# Two options for isolation (pick one):
#  (a) A separate free Upstash database — set its URL/token here, leave prefix blank.
#  (b) Reuse the dev Upstash database but namespace every key via REDIS_KEY_PREFIX.
#      redisGet/redisSet honour this prefix. NOTE: apiUsage.service.js uses the
#      raw client and is NOT prefixed — integration tests should mock outbound
#      HTTP (task 0.7) so those counters are never written, or use option (a).
UPSTASH_REDIS_REST_URL=https://your-test-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-test-upstash-rest-token
REDIS_KEY_PREFIX=haum_test:
# PERF-1 — TCP endpoint for BullMQ (queue producer + worker). Test files that
# touch the queue mock 'bullmq'/ioredis rather than connecting for real — this
# only needs to be a plausible value so nothing reads `undefined` at import time.
UPSTASH_REDIS_URL=rediss://default:your-test-token@your-test-db.upstash.io:6379

# --- Auth --------------------------------------------------------------------
JWT_SECRET=test-jwt-secret-not-a-real-secret-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_DOMAIN=

# --- Payments (Razorpay TEST mode only) -----------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=test-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=test-razorpay-webhook-secret

# --- External APIs ---------------------------------------------------------
# These are never called for real in tests — outbound HTTP is intercepted by the
# mock layer (nock / MSW, task 0.7). Keep obvious dummy values so a leak is loud.
GROQ_API_KEY=mock-groq-key
GOOGLE_PLACES_API_KEY=mock-google-key
OPENAQ_API_KEY=mock-openaq-key
OPENWEATHER_API_KEY=mock-openweather-key
WAQI_API_KEY=mock-waqi-key
GNEWS_API_KEY=mock-gnews-key
NEWSAPI_API_KEY=mock-newsapi-key
CPCB_API_KEY=mock-cpcb-key
HOWLOUD_API_KEY=

# --- Email (no real SMTP in tests) ---------------------------------------
# Leave EMAIL_HOST unset so email.service.js short-circuits, or point at a
# capture server (e.g. Mailpit) if a test needs to assert on message content.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Haum <no-reply@test.local>

# --- Cloudinary (unused in tests) --------------------------------------
CLOUDINARY_CLOUD_NAME=mock
CLOUDINARY_API_KEY=mock
CLOUDINARY_API_SECRET=mock

# --- Dev -------------------------------------------------------------------
DEV_UNLOCK=false
