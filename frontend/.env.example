# =============================================================================
# Haum / VibeScout — Frontend environment (.env.local)
# Copy to `.env.local` and fill in real values. NEVER commit the real file.
# Only NEXT_PUBLIC_* vars are exposed to the browser — never put secrets here.
# =============================================================================

# Base URL of the backend API (server-to-server and client fetches).
# Local dev: http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Google Maps JS + Places (browser key — HTTP-referrer restricted to prod domain)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-browser-key

# Razorpay publishable key id (rzp_test_* for dev/test)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# When "true", shows a "skip payment" dev button. MUST be unset/false in production.
NEXT_PUBLIC_DEV_UNLOCK=false
